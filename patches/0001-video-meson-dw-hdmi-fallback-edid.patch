+/*
+ * Canned single-block 1080p60 EDID ("ZTE W103D"), used when no EDID can
+ * be read from the sink. Checksum is valid; parsed by edid_get_timing().
+ */
+static const u8 meson_dw_hdmi_fallback_edid[128] = {
+	0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00,
+	0x6a, 0x85, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x01, 0x24, 0x01, 0x04, 0xa5, 0x30, 0x1b, 0x78,
+	0xea, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+	0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x02, 0x3a,
+	0x80, 0x18, 0x71, 0x38, 0x2d, 0x40, 0x58, 0x2c,
+	0x45, 0x00, 0xc4, 0x8e, 0x21, 0x00, 0x00, 0x1e,
+	0x00, 0x00, 0x00, 0xfc, 0x00, 0x57, 0x31, 0x30,
+	0x33, 0x44, 0x0a, 0x20, 0x20, 0x20, 0x20, 0x20,
+	0x20, 0x20, 0x00, 0x00, 0x00, 0x10, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x21,
+};
+
+static const u8 meson_dw_hdmi_edid_header[8] =
+	{ 0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00 };
+
+static bool meson_dw_hdmi_edid_valid(const u8 *buf)
+{
+	int i, sum = 0;
+
+	if (memcmp(buf, meson_dw_hdmi_edid_header, 8))
+		return false;
+	for (i = 0; i < 128; i++)
+		sum += buf[i];
+	return !(sum & 0xff);
+}
